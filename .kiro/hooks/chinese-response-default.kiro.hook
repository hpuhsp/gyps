{
  "enabled": true,
  "name": "Reply in Chinese by default",
  "description": "When the user submits a prompt, automatically remind the AI assistant to respond in Chinese.",
  "version": "1",
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "askAgent",
    "prompt": ""
  },
  "workspaceFolderName": "Gyps",
  "shortName": "chinese-response-default"
}